---
import SectionHeader from "../components/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found. — Emir Celovic">
  <div class="container pt-r-7 pb-r-9">
    <SectionHeader number="00" label="Error 404" />
    <div class="reveal reveal-1">
      <h1
        class="mb-r-4 max-w-[18ch] text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.05] tracking-tighter [font-variation-settings:'opsz'_96]"
      >
        Page not found.
      </h1>
      <p class="lead">
        The page you were looking for does not exist, or has been moved. Return
        to the index.
      </p>
      <a
        class="linklike mt-r-5 inline-block font-mono text-label tracking-wide uppercase"
        href="/"
        >← Back to index</a
      >
    </div>
  </div>
</BaseLayout>
