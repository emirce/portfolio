---
const pathLabel =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---

<a
  href="/"
  class="group inline-flex items-center gap-[0.7ch] font-mono text-label font-semibold tracking-wide text-ink transition-colors duration-[220ms] ease-out"
  aria-label="Home"
>
  <img
    src="/img/bear_drawing.webp"
    alt=""
    class="block h-[1.7em] w-auto"
    width="24"
    height="24"
    decoding="async"
  >
  <span>{pathLabel}</span>
</a>
