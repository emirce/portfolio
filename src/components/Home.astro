---
import { getCollection } from 'astro:content';
import { t } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';
import ProjectRow from './ProjectRow.astro';
import PostRow from './PostRow.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('posts', (e) => !e.data.draft);
const posts = allPosts.sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date)).slice(0, 5);
---

<div class="home container">
  <section class="section section--hero" aria-labelledby="sec-01">
    <div class="reveal reveal-1">
      <SectionHeader number="01" label={t('sec.01.label')} id="sec-01" />
    </div>

    <div class="hero">
      <p class="hero__intro reveal reveal-2">{t('hero.intro')}</p>

      <dl class="hero__contacts reveal reveal-3">
        <div class="hero__contact">
          <dt class="hero__contact-label">{t('elsewhere.linkedin')}</dt>
          <dd class="hero__contact-value">
            <a
              class="linklike"
              href="https://www.linkedin.com/in/emir-celovic-68316a217/"
              rel="noopener noreferrer me"
              target="_blank"
            >
              linkedin.com/in/emir-celovic
            </a>
          </dd>
        </div>
        <div class="hero__contact">
          <dt class="hero__contact-label">{t('elsewhere.x')}</dt>
          <dd class="hero__contact-value">
            <a class="linklike" href="https://x.com/emirthedev" rel="noopener noreferrer me" target="_blank">
              x.com/emirthedev
            </a>
          </dd>
        </div>
        <div class="hero__contact">
          <dt class="hero__contact-label">{t('elsewhere.github')}</dt>
          <dd class="hero__contact-value">
            <a class="linklike" href="https://github.com/emirce" rel="noopener noreferrer me" target="_blank">
              github.com/emirce
            </a>
          </dd>
        </div>
        <div class="hero__contact">
          <dt class="hero__contact-label">{t('elsewhere.email')}</dt>
          <dd class="hero__contact-value">
            <a class="linklike" href="mailto:emir@celovic.com">emir@celovic.com</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="sec-02">
    <div class="reveal reveal-1">
      <SectionHeader number="02" label={t('sec.02.label')} id="sec-02" />
    </div>
    <div class="rows reveal reveal-2">
      {projects.map((p) => (
        <ProjectRow
          number={p.data.number}
          title={p.data.title}
          year={p.data.year}
          tags={p.data.tags}
          status={p.data.status}
          slug={p.data.slug}
        />
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="sec-03">
    <div class="reveal reveal-1">
      <SectionHeader number="03" label={t('sec.03.label')} id="sec-03" />
    </div>
    <div class="section-grid reveal reveal-2">
      <p class="label">2026 —</p>
      <div class="prose about-prose">
        <p>{t('about.body_p1')}</p>
        <p>{t('about.body_p2')}</p>
        <p>{t('about.body_p3')}</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sec-04">
    <div class="reveal reveal-1">
      <SectionHeader number="04" label={t('sec.04.label')} id="sec-04" />
    </div>
    {posts.length > 0 ? (
      <div class="rows reveal reveal-2">
        {posts.map((p) => (
          <PostRow title={p.data.title} date={p.data.date} slug={p.data.slug} />
        ))}
        <div class="rows__more">
          <a class="linklike" href="/writing/">{t('writing.see_all')} →</a>
        </div>
      </div>
    ) : (
      <p class="empty reveal reveal-2">{t('writing.empty')}</p>
    )}
  </section>
</div>

<style>
  .home { padding-top: var(--r-7); }

  .section--hero {
    padding-top: var(--r-6);
    padding-bottom: var(--r-7);
  }

  .hero {
    display: grid;
    gap: var(--r-7);
  }
  .hero__intro {
    font-size: var(--t-lead);
    line-height: var(--lh-body);
    color: var(--c-ink);
    max-width: 52ch;
    text-wrap: pretty;
    margin: 0;
  }
  .hero__contacts {
    margin: 0;
    display: grid;
    gap: 0;
    max-width: 56ch;
  }
  .hero__contact {
    display: grid;
    grid-template-columns: minmax(0, 14ch) minmax(0, 1fr);
    gap: var(--r-4);
    padding: var(--r-2) 0;
    align-items: baseline;
  }
  .hero__contact-label {
    font-family: var(--f-mono);
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--c-mute);
  }
  .hero__contact-value {
    margin: 0;
    font-size: var(--t-body);
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 540px) {
    .hero__contact {
      grid-template-columns: 1fr;
      gap: 2px;
      padding: var(--r-3) 0;
    }
  }

  .rows { display: block; }
  .rows__more {
    margin-top: var(--r-5);
    font-family: var(--f-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-wide);
    color: var(--c-mute);
  }
  .empty {
    color: var(--c-mute);
    font-size: var(--t-lead);
    max-width: 50ch;
    padding: var(--r-3) 0;
  }
  .about-prose p + p {
    margin-top: var(--r-4);
  }
</style>
