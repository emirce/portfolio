---
import { getCollection } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import ProjectRow from "./ProjectRow.astro";
import PostRow from "./PostRow.astro";

const R2_ART_BASE = "https://assets.celovic.com/art/";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection("posts", (e) => !e.data.draft);
const posts = allPosts
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 5);

const allArt = await getCollection("art");
const artPreview = allArt
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<div class="home container">
  <section class="section section--hero" aria-labelledby="sec-01">
    <div class="reveal reveal-1">
      <SectionHeader number="01" label="Index" id="sec-01" />
    </div>

    <div class="hero">
      <div class="hero__main">
        <p class="hero__intro reveal reveal-2">
          Hi, I'm Emir. Software developer and mechanical engineer. I build
          stuff for the web and ecommerce.
        </p>
        <p class="hero__intro reveal reveal-2">
          Currently building <i>Kord</i>.
        </p>

        <dl class="hero__contacts reveal reveal-3">
          <div class="hero__contact">
            <dt class="hero__contact-label">LinkedIn</dt>
            <dd class="hero__contact-value">
              <a
                class="linklike"
                href="https://www.linkedin.com/in/emir-celovic-68316a217/"
                rel="noopener noreferrer me"
                target="_blank"
              >
                linkedin.com/in/emir-celovic
              </a>
            </dd>
          </div>
          <div class="hero__contact">
            <dt class="hero__contact-label">X</dt>
            <dd class="hero__contact-value">
              <a
                class="linklike"
                href="https://x.com/emirthedev"
                rel="noopener noreferrer me"
                target="_blank"
              >
                x.com/emirthedev
              </a>
            </dd>
          </div>
          <div class="hero__contact">
            <dt class="hero__contact-label">GitHub</dt>
            <dd class="hero__contact-value">
              <a
                class="linklike"
                href="https://github.com/emirce"
                rel="noopener noreferrer me"
                target="_blank"
              >
                github.com/emirce
              </a>
            </dd>
          </div>
          <div class="hero__contact">
            <dt class="hero__contact-label">Email</dt>
            <dd class="hero__contact-value">
              <a class="linklike" href="mailto:emir@celovic.com"
                >emir@celovic.com</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <figure class="hero__media reveal reveal-3" aria-hidden="true">
        <img
          src="/img/bear_drawing.webp"
          alt=""
          width="512"
          height="512"
          loading="eager"
          decoding="async"
        >
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="sec-02">
    <div class="reveal reveal-1">
      <SectionHeader number="02" label="Selected Work" id="sec-02" />
    </div>
    <div class="rows reveal reveal-2">
      {projects.map((p) => (
        <ProjectRow
          number={p.data.number}
          title={p.data.title}
          year={p.data.year}
          tags={p.data.tags}
          status={p.data.status}
          slug={p.data.slug}
        />
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="sec-03">
    <div class="reveal reveal-1">
      <SectionHeader number="03" label="About" id="sec-03" />
    </div>
    <div class="section-grid reveal reveal-2">
      <p class="label">2026 —</p>
      <div class="prose about-prose">
        <p>
          I work across the stack with a quiet preference for the parts users
          actually touch. My background is in TypeScript, Node, and the kind of
          internal tooling that, when done right, recedes from view.
        </p>
        <p>
          I care about typography, performance, and the small operational
          details that compound. I try to write software that is honest about
          its limits and pleasant to live with.
        </p>
        <p>
          When I am not shipping, I am usually reading, walking, or sketching
          out something that may or may not become a project.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sec-04">
    <div class="reveal reveal-1">
      <SectionHeader number="04" label="Writing" id="sec-04" />
    </div>
    {posts.length > 0 ? (
      <div class="rows reveal reveal-2">
        {posts.map((p) => (
          <PostRow title={p.data.title} date={p.data.date} slug={p.data.slug} />
        ))}
        <div class="rows__more">
          <a class="linklike" href="/writing/">All notes →</a>
        </div>
      </div>
    ) : (
      <p class="empty reveal reveal-2">
        Notes in progress. The first piece will arrive here when it is ready.
      </p>
    )}
  </section>

  <section class="section" aria-labelledby="sec-05">
    <div class="reveal reveal-1">
      <SectionHeader number="05" label="Art" id="sec-05" />
    </div>
    {artPreview.length > 0 ? (
      <div class="art-strip reveal reveal-2">
        <p class="art-strip__lead">
          Maps and cartographic studies, mostly drawn by hand.
        </p>
        <ul class="art-strip__grid">
          {artPreview.map((p) => (
            <li class="art-strip__item">
              <a class="art-strip__link" href="/art/" aria-label={`View ${p.data.title}`}>
                <img
                  src={`${R2_ART_BASE}${p.data.key}`}
                  alt=""
                  width={p.data.width}
                  height={p.data.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ul>
        <div class="rows__more">
          <a class="linklike" href="/art/">All pieces →</a>
        </div>
      </div>
    ) : (
      <p class="empty reveal reveal-2">
        Pieces in progress. The first will arrive here when it is ready.
      </p>
    )}
  </section>
</div>

<style>
.home {
  padding-top: var(--r-7);
}

.section--hero {
  padding-top: var(--r-6);
  padding-bottom: var(--r-7);
}

.hero {
  display: grid;
  gap: var(--r-7);
  grid-template-columns: minmax(0, 1fr);
  align-items: center;
}
.hero__main {
  display: grid;
  gap: var(--r-7);
  min-width: 0;
}
.hero__media {
  margin: 0;
  min-width: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}
.hero__media img {
  display: block;
  width: 100%;
  height: auto;
  max-width: 460px;
  mix-blend-mode: multiply;
}
@media (min-width: 860px) {
  .hero {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--r-8);
  }
  .hero__media {
    justify-content: flex-end;
  }
}
.hero__intro {
  font-size: var(--t-lead);
  line-height: var(--lh-body);
  color: var(--c-ink);
  max-width: 52ch;
  text-wrap: pretty;
  margin: 0;
}
.hero__contacts {
  margin: 0;
  display: grid;
  gap: 0;
  max-width: 56ch;
}
.hero__contact {
  display: grid;
  grid-template-columns: minmax(0, 14ch) minmax(0, 1fr);
  gap: var(--r-4);
  padding: var(--r-2) 0;
  align-items: baseline;
}
.hero__contact-label {
  font-family: var(--f-mono);
  font-size: var(--t-eyebrow);
  font-weight: 500;
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
  color: var(--c-mute);
}
.hero__contact-value {
  margin: 0;
  font-size: var(--t-body);
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}
@media (max-width: 540px) {
  .hero__contact {
    grid-template-columns: 1fr;
    gap: 2px;
    padding: var(--r-3) 0;
  }
}

.rows {
  display: block;
}
.rows__more {
  margin-top: var(--r-5);
  font-family: var(--f-mono);
  font-size: var(--t-label);
  text-transform: uppercase;
  letter-spacing: var(--tr-wide);
  color: var(--c-mute);
}
.empty {
  color: var(--c-mute);
  font-size: var(--t-lead);
  max-width: 50ch;
  padding: var(--r-3) 0;
}
.about-prose p + p {
  margin-top: var(--r-4);
}

.art-strip__lead {
  color: var(--c-mute);
  font-size: var(--t-lead);
  max-width: 50ch;
  margin: 0 0 var(--r-5);
}
.art-strip__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--r-4);
}
.art-strip__item {
  margin: 0;
}
.art-strip__link {
  display: block;
  background: var(--c-paper-deep);
  border: 1px solid var(--c-rule);
  aspect-ratio: 4 / 3;
  overflow: hidden;
  transition: border-color 220ms var(--ease-out);
}
.art-strip__link:hover {
  border-color: var(--c-rule-hard);
}
.art-strip__link img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: multiply;
  transition: transform 600ms var(--ease-out);
}
.art-strip__link:hover img {
  transform: scale(1.02);
}
@media (max-width: 540px) {
  .art-strip__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .art-strip__item:nth-child(3) {
    display: none;
  }
}
</style>
