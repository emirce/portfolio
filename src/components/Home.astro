---
import { getCollection } from "astro:content";
import ContactList from "./ContactList.astro";
import PostRow from "./PostRow.astro";
import ProjectRow from "./ProjectRow.astro";
import SectionHeader from "./SectionHeader.astro";

const heroContacts = [
  {
    label: "LinkedIn",
    value: "linkedin.com/in/emir-celovic",
    href: "https://www.linkedin.com/in/emir-celovic-68316a217/",
    icon: "/icons/linkedin.svg",
  },
  {
    label: "X",
    value: "x.com/emirthedev",
    href: "https://x.com/emirthedev",
    icon: "/icons/x.svg",
  },
  {
    label: "GitHub",
    value: "github.com/emirce",
    href: "https://github.com/emirce",
    icon: "/icons/github.svg",
  },
  {
    label: "Email",
    value: "emir@celovic.com",
    href: "mailto:emir@celovic.com",
    icon: "/icons/email.svg",
  },
];

const R2_ART_BASE = "https://assets.celovic.com/art/";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection("posts", (e) => !e.data.draft);
const posts = allPosts
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 5);

const allArt = await getCollection("art");
const artPreview = allArt
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<div class="home container">
  <section class="section section--hero" aria-labelledby="sec-01">
    <div class="reveal reveal-1">
      <SectionHeader number="01" label="Index" id="sec-01" />
    </div>

    <div class="hero">
      <div class="hero__main">
        <p class="hero__intro reveal reveal-2">
          Hi, I'm Emir. Software developer and mechanical engineer. I build
          stuff for the web and ecommerce.
        </p>
        <p class="hero__intro reveal reveal-2">
          Currently building <i>Kord</i>.
        </p>

        <div class="reveal reveal-3"><ContactList items={heroContacts} /></div>
      </div>

      <figure class="hero__media reveal reveal-3" aria-hidden="true">
        <img
          src="/img/bear_drawing.webp"
          alt=""
          width="512"
          height="512"
          loading="eager"
          decoding="async"
        >
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="sec-02">
    <div class="reveal reveal-1">
      <SectionHeader number="02" label="Selected Work" id="sec-02" />
    </div>
    <div class="rows reveal reveal-2">
      {projects.map((p) => (
        <ProjectRow
          number={p.data.number}
          title={p.data.title}
          year={p.data.year}
          tags={p.data.tags}
          status={p.data.status}
          slug={p.data.slug}
        />
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="sec-03">
    <div class="reveal reveal-1">
      <SectionHeader number="03" label="Writing" id="sec-03" />
    </div>
    {posts.length > 0 ? (
      <div class="rows reveal reveal-2">
        {posts.map((p) => (
          <PostRow title={p.data.title} date={p.data.date} slug={p.data.slug} />
        ))}
        <div class="rows__more">
          <a class="linklike" href="/writing/">All notes →</a>
        </div>
      </div>
    ) : (
      <p class="empty reveal reveal-2">
        Notes in progress. The first piece will arrive here when it is ready.
      </p>
    )}
  </section>

  <section class="section" aria-labelledby="sec-04">
    <div class="reveal reveal-1">
      <SectionHeader number="04" label="Art" id="sec-04" />
    </div>
    {artPreview.length > 0 ? (
      <div class="art-strip reveal reveal-2">
        <p class="art-strip__lead">
          Maps and cartographic art. Mostly work done for Cartographr Co.
        </p>
        <ul class="art-strip__grid">
          {artPreview.map((p) => (
            <li class="art-strip__item">
              <a class="art-strip__link" href="/art/" aria-label={`View ${p.data.title}`}>
                <img
                  src={`${R2_ART_BASE}${p.data.key}`}
                  alt=""
                  width={p.data.width}
                  height={p.data.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ul>
        <div class="rows__more">
          <a class="linklike" href="/art/">All pieces →</a>
        </div>
      </div>
    ) : (
      <p class="empty reveal reveal-2">
        Pieces in progress. The first will arrive here when it is ready.
      </p>
    )}
  </section>
</div>

<style>
.home {
  padding-top: var(--r-7);
}

.section--hero {
  padding-top: var(--r-6);
  padding-bottom: var(--r-7);
}

.hero {
  display: grid;
  gap: var(--r-6);
  grid-template-columns: minmax(0, 1fr);
  align-items: center;
}
.hero__main {
  display: grid;
  gap: var(--r-7);
  min-width: 0;
  order: 2;
}
.hero__media {
  margin: 0;
  min-width: 0;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  order: 1;
}
.hero__media img {
  display: block;
  width: 100%;
  height: auto;
  max-width: 100px;
  mix-blend-mode: multiply;
}
@media (min-width: 860px) {
  .hero {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--r-8);
  }
  .hero__main {
    order: 0;
  }
  .hero__media {
    justify-content: flex-end;
    order: 0;
  }
  .hero__media img {
    max-width: 460px;
  }
}
.hero__intro {
  font-size: var(--t-lead);
  line-height: var(--lh-body);
  color: var(--c-ink);
  max-width: 52ch;
  text-wrap: pretty;
  margin: 0;
}
.rows {
  display: block;
}
.rows__more {
  margin-top: var(--r-5);
  font-family: var(--f-mono);
  font-size: var(--t-label);
  text-transform: uppercase;
  letter-spacing: var(--tr-wide);
  color: var(--c-mute);
}
.empty {
  color: var(--c-mute);
  font-size: var(--t-lead);
  max-width: 50ch;
  padding: var(--r-3) 0;
}
.art-strip__lead {
  color: var(--c-mute);
  font-size: var(--t-lead);
  max-width: 50ch;
  margin: 0 0 var(--r-5);
}
.art-strip__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--r-4);
}
.art-strip__item {
  margin: 0;
}
.art-strip__link {
  display: block;
  background: var(--c-paper-deep);
  border: 1px solid var(--c-rule);
  aspect-ratio: 4 / 3;
  overflow: hidden;
  transition: border-color 220ms var(--ease-out);
}
.art-strip__link:hover {
  border-color: var(--c-rule-hard);
}
.art-strip__link img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: multiply;
  transform: scale(1.25);
  transform-origin: center;
  transition: transform 600ms var(--ease-out);
}
.art-strip__link:hover img {
  transform: scale(1);
}
@media (max-width: 540px) {
  .art-strip__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .art-strip__item:nth-child(3) {
    display: none;
  }
}
</style>
