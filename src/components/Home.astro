---
import { getCollection } from "astro:content";
import { getWorkEntries } from "../sanity/work";
import { getWritingDate, getWritingEntries } from "../sanity/writing";
import ContactList from "./ContactList.astro";
import PostRow from "./PostRow.astro";
import ProjectRow from "./ProjectRow.astro";

const R2_ART_BASE = "https://assets.celovic.com/art/";

const projects = await getWorkEntries();

const posts = (await getWritingEntries()).slice(0, 5);

const allArt = await getCollection("art");
const artPreview = allArt
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<div class="wrap pt-8">
  <section>
    <h1 class="sr-only">Emir Celovic</h1>
    <p>Currently building Cartographr Co.</p>
    <div class="mt-3 text-muted"><ContactList /></div>
  </section>

  <section class="mt-16" aria-labelledby="work">
    <h2 class="mb-4 text-sm text-muted" id="work">Work</h2>
    <ul class="grid gap-5">
      {projects.map((p) => (
        <ProjectRow
          key={p._id}
          title={p.title}
          year={p.year}
          summary={p.summary}
          status={p.status}
          slug={p.slug}
        />
      ))}
    </ul>
  </section>

  <section class="mt-16" aria-labelledby="writing">
    <div class="mb-4 flex items-baseline justify-between text-sm text-muted">
      <h2 id="writing">Writing</h2>
      {posts.length > 0 && <a class="link" href="/writing/">All notes</a>}
    </div>
    {posts.length > 0 ? (
      <ul class="grid gap-3">
        {posts.map((p) => (
          <PostRow key={p._id} title={p.title} date={getWritingDate(p)} slug={p.slug} />
        ))}
      </ul>
    ) : (
      <p class="text-muted">Nothing here yet.</p>
    )}
  </section>

  <section class="mt-16" aria-labelledby="art">
    <div class="mb-4 flex items-baseline justify-between text-sm text-muted">
      <h2 id="art">Art</h2>
      {artPreview.length > 0 && <a class="link" href="/art/">All pieces</a>}
    </div>
    {artPreview.length > 0 ? (
      <ul class="grid grid-cols-3 gap-3">
        {artPreview.map((p) => (
          <li key={p.id}>
            <a
              class="block aspect-[4/3] overflow-hidden rounded-md bg-subtle transition-opacity hover:opacity-85"
              href="/art/"
              aria-label={`View ${p.data.title}`}
            >
              <img
                src={`${R2_ART_BASE}${p.data.key}`}
                alt=""
                class="size-full object-cover"
                width={p.data.width}
                height={p.data.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted">Nothing here yet.</p>
    )}
  </section>
</div>
