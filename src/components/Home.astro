---
import { getCollection } from "astro:content";
import ContactList from "./ContactList.astro";
import PostRow from "./PostRow.astro";
import ProjectRow from "./ProjectRow.astro";
import SectionHeader from "./SectionHeader.astro";

const heroContacts = [
  {
    label: "LinkedIn",
    value: "linkedin.com/in/emir-celovic",
    href: "https://www.linkedin.com/in/emir-celovic-68316a217/",
    icon: "/icons/linkedin.svg",
  },
  {
    label: "X",
    value: "x.com/emirthedev",
    href: "https://x.com/emirthedev",
    icon: "/icons/x.svg",
  },
  {
    label: "GitHub",
    value: "github.com/emirce",
    href: "https://github.com/emirce",
    icon: "/icons/github.svg",
  },
  {
    label: "Email",
    value: "emir@celovic.com",
    href: "mailto:emir@celovic.com",
    icon: "/icons/email.svg",
  },
];

const R2_ART_BASE = "https://assets.celovic.com/art/";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection("posts", (e) => !e.data.draft);
const posts = allPosts
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 5);

const allArt = await getCollection("art");
const artPreview = allArt
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<div class="container pt-r-7">
  <section class="section pt-r-6 pb-r-7" aria-labelledby="sec-01">
    <div class="reveal reveal-1">
      <SectionHeader number="01" label="Index" id="sec-01" />
    </div>

    <div
      class="grid grid-cols-1 items-center gap-r-6 min-[860px]:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] min-[860px]:gap-r-8"
    >
      <div class="order-2 grid min-w-0 gap-r-7 min-[860px]:order-none">
        <p
          class="m-0 max-w-[52ch] text-lead leading-body text-ink reveal reveal-2"
        >
          Hi, I'm Emir. Software developer and mechanical engineer. I build
          stuff for the web and ecommerce.
        </p>
        <p
          class="m-0 max-w-[52ch] text-lead leading-body text-ink reveal reveal-2"
        >
          Currently building <i>Kord</i>.
        </p>

        <div class="reveal reveal-3"><ContactList items={heroContacts} /></div>
      </div>

      <figure
        class="order-1 m-0 flex min-w-0 items-center justify-start min-[860px]:order-none min-[860px]:justify-end reveal reveal-3"
        aria-hidden="true"
      >
        <img
          src="/img/bear_drawing.webp"
          alt=""
          class="block h-auto w-full max-w-[100px] mix-blend-multiply min-[860px]:max-w-[460px]"
          width="512"
          height="512"
          loading="eager"
          decoding="async"
        >
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="sec-02">
    <div class="reveal reveal-1">
      <SectionHeader number="02" label="Selected Work" id="sec-02" />
    </div>
    <div class="block reveal reveal-2">
      {projects.map((p) => (
        <ProjectRow
          number={p.data.number}
          title={p.data.title}
          year={p.data.year}
          tags={p.data.tags}
          status={p.data.status}
          slug={p.data.slug}
        />
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="sec-03">
    <div class="reveal reveal-1">
      <SectionHeader number="03" label="Writing" id="sec-03" />
    </div>
    {posts.length > 0 ? (
      <div class="block reveal reveal-2">
        {posts.map((p) => (
          <PostRow title={p.data.title} date={p.data.date} slug={p.data.slug} />
        ))}
        <div class="mt-r-5 font-mono text-label tracking-wide text-mute uppercase">
          <a class="linklike" href="/writing/">All notes →</a>
        </div>
      </div>
    ) : (
      <p class="max-w-[50ch] py-r-3 text-lead text-mute reveal reveal-2">
        Notes in progress. The first piece will arrive here when it is ready.
      </p>
    )}
  </section>

  <section class="section" aria-labelledby="sec-04">
    <div class="reveal reveal-1">
      <SectionHeader number="04" label="Art" id="sec-04" />
    </div>
    {artPreview.length > 0 ? (
      <div class="reveal reveal-2">
        <p class="m-0 mb-r-5 max-w-[50ch] text-lead text-mute">
          Maps and cartographic art. Mostly work done for Cartographr Co.
        </p>
        <ul class="m-0 grid list-none grid-cols-3 gap-r-4 p-0 max-[540px]:grid-cols-2">
          {artPreview.map((p) => (
            <li class="m-0 max-[540px]:nth-[3]:hidden">
              <a
                class="group block aspect-[4/3] overflow-hidden border border-rule bg-paper-deep transition-colors duration-[220ms] ease-out hover:border-rule-hard"
                href="/art/"
                aria-label={`View ${p.data.title}`}
              >
                <img
                  src={`${R2_ART_BASE}${p.data.key}`}
                  alt=""
                  class="block size-full scale-125 object-cover mix-blend-multiply transition-transform duration-[600ms] ease-out group-hover:scale-100"
                  width={p.data.width}
                  height={p.data.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-r-5 font-mono text-label tracking-wide text-mute uppercase">
          <a class="linklike" href="/art/">All pieces →</a>
        </div>
      </div>
    ) : (
      <p class="max-w-[50ch] py-r-3 text-lead text-mute reveal reveal-2">
        Pieces in progress. The first will arrive here when it is ready.
      </p>
    )}
  </section>
</div>
