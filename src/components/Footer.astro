---
import ContactList from "./ContactList.astro";

const year = new Date().getFullYear();
---

<footer class="wrap mt-24 pb-10">
  <div
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-border border-t pt-6 text-sm text-muted"
  >
    <p>
      © {year} Emir Celovic ·
      <a
        class="link"
        href="https://github.com/emirce/portfolio"
        rel="noopener noreferrer"
        target="_blank"
        >Source</a
      >
    </p>
    <ContactList />
  </div>
</footer>
