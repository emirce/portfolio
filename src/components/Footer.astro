---
import ContactList from "./ContactList.astro";
import SectionHeader from "./SectionHeader.astro";

const year = new Date().getFullYear();

const footerContacts = [
  {
    label: "GitHub",
    value: "github.com/emirce",
    href: "https://github.com/emirce",
    icon: "/icons/github.svg",
  },
  {
    label: "X",
    value: "x.com/emirthedev",
    href: "https://x.com/emirthedev",
    icon: "/icons/x.svg",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/emir-celovic",
    href: "https://www.linkedin.com/in/emir-celovic-68316a217/",
    icon: "/icons/linkedin.svg",
  },
  {
    label: "Email",
    value: "emir@celovic.com",
    href: "mailto:emir@celovic.com",
    icon: "/icons/email.svg",
  },
];
---

<footer class="foot">
  <div class="container">
    <SectionHeader number="05" label="Elsewhere" id="elsewhere" />
    <ContactList items={footerContacts} />

    <hr class="rule foot__rule">

    <div class="foot__bottom">
      <span class="foot__copy"
        >© {year} Emir Celovic · Built quietly in 2026.</span
      >
      <span class="foot__meta">
        <a class="foot__link" href="/writing/hello-world/">Hello, World!</a>
      </span>
    </div>
  </div>
</footer>

<style>
.foot {
  padding-top: var(--r-9);
  padding-bottom: var(--r-7);
  border-top: 1px solid var(--c-rule);
  margin-top: var(--r-9);
  background: var(--c-paper);
}
.foot__rule {
  margin: var(--r-7) 0 var(--r-5);
}
.foot__bottom {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--r-3);
  font-family: var(--f-mono);
  font-size: var(--t-eyebrow);
  color: var(--c-mute);
  text-transform: uppercase;
  letter-spacing: var(--tr-eyebrow);
}
.foot__meta {
  display: inline-flex;
  gap: 0.8ch;
  align-items: baseline;
}
.foot__sep {
  color: var(--c-faint);
}
.foot__link {
  color: var(--c-mute);
  border-bottom: 1px solid transparent;
  transition:
    color 220ms var(--ease-out),
    border-color 220ms var(--ease-out);
}
.foot__link:hover {
  color: var(--c-accent);
  border-bottom-color: var(--c-accent);
}
</style>
