---
interface Props {
  title: string;
  date: Date;
  slug: string;
}

const { title, date, slug } = Astro.props;
const href = `/writing/${slug}/`;
const dateFmt = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(date);
const dateParts = dateFmt
  .replace(/\./g, "·")
  .replace(/\//g, "·")
  .replace(/-/g, "·");
---

<a
  class="group grid grid-cols-[14ch_minmax(0,1fr)_2ch] items-baseline gap-r-4 border-rule border-b py-r-4 text-ink transition-[padding-left,color] duration-[280ms,220ms] ease-out first:border-t hover:pl-r-3 hover:text-accent max-[540px]:grid-cols-[1fr_2ch] max-[540px]:grid-rows-2 max-[540px]:gap-x-r-4 max-[540px]:gap-y-[2px]"
  href={href}
>
  <span
    class="font-mono text-eyebrow tracking-wide text-mute numerals max-[540px]:col-span-full"
    >{dateParts}</span
  >
  <span class="text-lead font-medium tracking-tight">{title}</span>
  <span
    class="text-right font-mono text-faint transition-[transform,color] duration-[280ms,220ms] ease-out group-hover:translate-x-1 group-hover:text-accent max-[540px]:hidden"
    aria-hidden="true"
  >
    →
  </span>
</a>
