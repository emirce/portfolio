---
interface Props {
  title: string;
  date: Date;
  slug: string;
}

const { title, date, slug } = Astro.props;

const dateLabel = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(date);
---

<li class="flex items-baseline justify-between gap-6">
  <a class="link font-medium" href={`/writing/${slug}/`}>{title}</a>
  <time
    class="shrink-0 text-sm text-muted tabular-nums"
    datetime={date.toISOString()}
  >
    {dateLabel}
  </time>
</li>
