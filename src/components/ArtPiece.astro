---
const R2_ART_BASE = "https://assets.celovic.com/art/";

interface Props {
  title: string;
  year: number;
  medium?: string;
  imageKey: string;
  alt: string;
  width: number;
  height: number;
  copyright: string;
  eager?: boolean;
}

const { title, year, medium, imageKey, alt, width, height, copyright, eager } =
  Astro.props;
const src = `${R2_ART_BASE}${imageKey}`;

const noteHtml = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : "";
const hasNote = noteHtml.replace(/<[^>]*>/g, "").trim().length > 0;

const meta = [year, medium, `© ${copyright}`].filter(Boolean).join(" · ");
---

<figure>
  <img
    src={src}
    alt={alt}
    class="h-auto w-full rounded-md bg-subtle"
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  >
  <figcaption class="mt-4">
    <p class="font-medium">{title}</p>
    <p class="text-sm text-muted">{meta}</p>
    {hasNote && <div class="prose mt-3 text-muted"><slot /></div>}
  </figcaption>
</figure>
