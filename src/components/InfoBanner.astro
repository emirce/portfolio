---
interface Props {
  label?: string;
  tone?: "default" | "accent";
}

const { label = "Note", tone = "default" } = Astro.props;
---

<aside
  class:list={[
    "my-r-6 grid grid-cols-[auto_1fr] items-baseline gap-r-4 border-rule-hard border-y bg-paper-deep px-r-5 py-r-4 max-[540px]:grid-cols-1 max-[540px]:gap-r-2 max-[540px]:p-r-4",
    tone === "accent" && "border-accent bg-transparent",
  ]}
  role="note"
>
  <span
    class="whitespace-nowrap font-mono text-eyebrow font-semibold tracking-eyebrow text-accent uppercase"
    >{label}</span
  >
  <div
    class="font-sans text-small leading-body text-ink [&>:first-child]:mt-0 [&>:last-child]:mb-0"
  >
    <slot />
  </div>
</aside>
