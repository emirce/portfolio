---
export interface ContactItem {
  label: string;
  value: string;
  href: string;
  icon: string;
}

interface Props {
  items: ContactItem[];
}

const { items } = Astro.props;
---

<ul class="m-0 flex list-none flex-wrap items-center gap-r-4 p-0" role="list">
  {items.map((item) => {
    const isMailto = item.href.startsWith("mailto:");
    return (
      <li class="m-0">
        <a
          class="inline-flex size-9 items-center justify-center border border-rule bg-paper/50 text-mute opacity-80 transition-[border-color,background-color,opacity,transform] duration-[220ms,220ms,220ms,320ms] ease-out hover:-translate-y-px hover:border-rule-hard hover:bg-paper-warm hover:opacity-100 focus-visible:opacity-100"
          href={item.href}
          aria-label={`${item.label}: ${item.value}`}
          rel="noopener noreferrer me"
          target={isMailto ? undefined : "_blank"}
        >
          <img
            class="block size-[22px] object-contain"
            src={item.icon}
            alt=""
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
          />
        </a>
      </li>
    );
  })}
</ul>
