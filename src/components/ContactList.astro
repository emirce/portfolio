---
import { contactLinks } from "../data/links";
---

<ul class="flex flex-wrap gap-x-4 gap-y-1">
  {contactLinks.map((item) => (
    <li key={item.href}>
      <a
        class="link"
        href={item.href}
        rel="noopener noreferrer me"
        target={item.href.startsWith("mailto:") ? undefined : "_blank"}
      >
        {item.label}
      </a>
    </li>
  ))}
</ul>
