---
export interface ContactItem {
  label: string;
  value: string;
  href: string;
  icon: string;
}

interface Props {
  items: ContactItem[];
}

const { items } = Astro.props;
---

<ul class="m-0 flex list-none flex-wrap items-center gap-r-4 p-0" role="list">
  {items.map((item) => {
    const isMailto = item.href.startsWith("mailto:");
    return (
      <li class="m-0">
        <a
          class="inline-flex size-8 items-center justify-center text-mute opacity-75 transition-opacity duration-[220ms] ease-out hover:opacity-100 focus-visible:opacity-100"
          href={item.href}
          aria-label={`${item.label} — ${item.value}`}
          rel="noopener noreferrer me"
          target={isMailto ? undefined : "_blank"}
        >
          <img
            class="block size-[22px] object-contain"
            src={item.icon}
            alt=""
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
          />
        </a>
      </li>
    );
  })}
</ul>
