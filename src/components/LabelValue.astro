---
interface Props {
  label: string;
  value?: string;
  accent?: boolean;
}

const { label, value, accent } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-[minmax(0,var(--container-label))_minmax(0,1fr)] items-baseline gap-r-4 py-r-2 max-[540px]:grid-cols-1 max-[540px]:gap-y-[2px] max-[540px]:py-r-3",
    accent && "text-ink",
  ]}
>
  <dt
    class="font-mono text-eyebrow font-medium tracking-eyebrow text-mute uppercase"
  >
    {label}
  </dt>
  <dd class="m-0 text-body text-ink numerals">{value ?? <slot />}</dd>
</div>
