---
interface Props {
  title: string;
  year: number;
  tags: string[];
  summary: string;
  link?: string;
  repo?: string;
}

const { title, year, tags, summary, link, repo } = Astro.props;

const meta = [year, ...tags].join(" · ");
const links = [
  link && { label: "Visit", href: link },
  repo && repo !== link && { label: "Source", href: repo },
].filter((l) => !!l);
---

<article class="wrap pt-8">
  <header class="mb-10">
    <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
    <p class="mt-2 text-muted">{summary}</p>
    <p class="mt-4 text-sm text-muted">{meta}</p>
    {links.length > 0 && (
      <ul class="mt-1 flex flex-wrap gap-x-4 text-sm">
        {links.map((l) => (
          <li key={l.href}>
            <a
              class="link"
              href={l.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              {l.href.replace(/^https?:\/\//, "")}
            </a>
          </li>
        ))}
      </ul>
    )}
  </header>

  <div class="prose"><slot /></div>
</article>
