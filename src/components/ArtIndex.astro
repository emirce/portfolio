---
import { getCollection, render } from "astro:content";
import ArtPiece from "./ArtPiece.astro";

const all = await getCollection("art");
const pieces = all.sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  pieces.map(async (p) => {
    const { Content } = await render(p);
    return { data: p.data, id: p.id, Content };
  }),
);
---

<div class="wrap pt-8">
  <header class="mb-10">
    <h1 class="text-2xl font-semibold tracking-tight">Art</h1>
    <p class="mt-2 text-muted">
      {pieces.length > 0
        ? "Maps and cartographic art. Mostly work done for Cartographr Co."
        : "Nothing here yet."}
    </p>
  </header>

  {pieces.length > 0 && (
    <div class="grid gap-16">
      {rendered.map(({ data, id, Content }, i) => (
        <ArtPiece
          key={id}
          title={data.title}
          year={data.year}
          medium={data.medium}
          imageKey={data.key}
          alt={data.alt}
          width={data.width}
          height={data.height}
          copyright={data.copyright}
          eager={i === 0}
        >
          <Content />
        </ArtPiece>
      ))}
    </div>
  )}
</div>
