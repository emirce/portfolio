---
import { getCollection, render } from "astro:content";
import ArtPiece from "./ArtPiece.astro";
import SectionHeader from "./SectionHeader.astro";

const all = await getCollection("art");
const pieces = all.sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  pieces.map(async (p) => {
    const { Content } = await render(p);
    return { data: p.data, Content };
  }),
);
---

<div class="container pt-r-7">
  <SectionHeader number="05" label="Art" />

  <header class="mb-r-8 reveal reveal-1">
    <h1
      class="mb-r-4 text-[clamp(2rem,5.5vw,3.5rem)] leading-[1.05] tracking-tighter [font-variation-settings:'opsz'_48]"
    >
      Art
    </h1>
    <p class="lead">
      {pieces.length > 0
        ? "Maps and cartographic art. Mostly work done for Cartographr Co."
        : "Pieces in progress. The first will arrive here when it is ready."}
    </p>
  </header>

  {pieces.length > 0 && (
    <div class="block reveal reveal-2">
      {rendered.map(({ data, Content }, i) => (
        <ArtPiece
          number={data.number}
          title={data.title}
          year={data.year}
          medium={data.medium}
          imageKey={data.key}
          alt={data.alt}
          width={data.width}
          height={data.height}
          copyright={data.copyright}
          eager={i === 0}
        >
          <Content />
        </ArtPiece>
      ))}
    </div>
  )}

  <nav
    class="mt-r-7 border-rule border-t pt-r-5 font-mono text-label tracking-wide uppercase reveal reveal-3"
  >
    <a class="linklike" href="/">← Back to index</a>
  </nav>
</div>
