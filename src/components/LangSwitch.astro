---
import type { Lang } from '../i18n/utils';
import { useTranslations, alternatePath, otherLang } from '../i18n/utils';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const t = useTranslations(lang);

const normalisedPath = pathname.replace(/^\/de\/?/, '/').replace(/\/+$/, '/') || '/';
const altPath = alternatePath(normalisedPath, lang);
const otherLocale = otherLang(lang);
const otherLabel = otherLocale.toUpperCase();
const currentLabel = lang.toUpperCase();
---

<div class="lang" role="group" aria-label={t('lang.switch_label')}>
  <span class="lang__current" aria-current="true">{currentLabel}</span>
  <span class="lang__sep" aria-hidden="true">/</span>
  <a
    class="lang__link"
    href={altPath}
    hreflang={otherLocale}
    aria-label={otherLocale === 'de' ? t('lang.alt_de') : t('lang.alt_en')}
  >{otherLabel}</a>
</div>

<style>
  .lang {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5ch;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
  }
  .lang__current {
    color: var(--c-ink);
  }
  .lang__sep {
    color: var(--c-faint);
  }
  .lang__link {
    color: var(--c-mute);
    transition: color 220ms var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .lang__link:hover {
    color: var(--c-accent);
    border-bottom-color: var(--c-accent);
  }
</style>
