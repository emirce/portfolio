---
interface Props {
  title: string;
  year: number;
  summary: string;
  status: "live" | "archived" | "upcoming";
  slug: string;
}

const { title, year, summary, status, slug } = Astro.props;

const isUpcoming = status === "upcoming";
---

<li class="flex items-baseline justify-between gap-6">
  <div class="min-w-0">
    {isUpcoming ? (
      <span class="font-medium text-muted">{title}</span>
    ) : (
      <a class="link font-medium" href={`/work/${slug}/`}>{title}</a>
    )}
    <p class="text-muted">{summary}</p>
  </div>
  <span class="shrink-0 text-sm text-muted tabular-nums">
    {isUpcoming ? "Soon" : year}
  </span>
</li>
