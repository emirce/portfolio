---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

{label ? (
		<span
			class="ml-[0.5ch] inline-block size-[0.6em] align-[0.06em] leading-none"
			role="img"
			aria-label={label}
		>
			<span
				class="block size-full rounded-full bg-accent shadow-[0_0_0_3px_rgb(194_74_31_/_18%)]"
				aria-hidden="true"
			/>
		</span>
	) : (
		<span class="ml-[0.5ch] inline-block size-[0.6em] align-[0.06em] leading-none">
			<span
				class="block size-full rounded-full bg-accent shadow-[0_0_0_3px_rgb(194_74_31_/_18%)]"
				aria-hidden="true"
			/>
		</span>
	)}
