---
import { getCollection } from "astro:content";
import PostRow from "./PostRow.astro";
import SectionHeader from "./SectionHeader.astro";

const all = await getCollection("posts", (e) => !e.data.draft);
const posts = all.sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
);
---

<div class="container pt-r-7">
  <SectionHeader number="04" label="Writing" />

  <header class="mb-r-7 reveal reveal-1">
    <h1
      class="mb-r-4 text-[clamp(2rem,5.5vw,3.5rem)] leading-[1.05] tracking-tighter [font-variation-settings:'opsz'_48]"
    >
      Writing
    </h1>
    <p class="lead">
      {posts.length > 0
        ? 'Short notes on software, tooling, and whatever sticks at the desk.'
        : 'Notes in progress. The first piece will arrive here when it is ready.'}
    </p>
  </header>

  {posts.length > 0 && (
    <div class="block reveal reveal-2">
      {posts.map((p) => (
        <PostRow title={p.data.title} date={p.data.date} slug={p.data.slug} />
      ))}
    </div>
  )}

  <nav
    class="mt-r-7 border-rule border-t pt-r-5 font-mono text-label tracking-wide uppercase reveal reveal-3"
  >
    <a class="linklike" href="/">← Back to index</a>
  </nav>
</div>
