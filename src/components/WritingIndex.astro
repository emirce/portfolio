---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { useTranslations, localizePath } from '../i18n/utils';
import SectionHeader from './SectionHeader.astro';
import PostRow from './PostRow.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection('posts', (e) => e.data.lang === lang && !e.data.draft);
const posts = all.sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
---

<div class="windex container">
  <SectionHeader number="04" label={t('sec.04.label')} />

  <header class="windex__head reveal reveal-1">
    <h1 class="windex__title">{t('nav.writing')}</h1>
    <p class="lead">
      {posts.length > 0
        ? lang === 'de'
          ? 'Notizen zu Software, Werkzeugen und dem, was am Schreibtisch hängen bleibt.'
          : 'Short notes on software, tooling, and whatever sticks at the desk.'
        : t('writing.empty')}
    </p>
  </header>

  {posts.length > 0 && (
    <div class="rows reveal reveal-2">
      {posts.map((p) => (
        <PostRow lang={lang} title={p.data.title} date={p.data.date} slug={p.data.slug} />
      ))}
    </div>
  )}

  <nav class="windex__nav reveal reveal-3">
    <a class="linklike" href={localizePath('/', lang)}>← {t('nav.back')}</a>
  </nav>
</div>

<style>
  .windex { padding-top: var(--r-7); }
  .windex__head { margin-bottom: var(--r-7); }
  .windex__title {
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: var(--tr-tighter);
    font-variation-settings: "opsz" 48;
    margin-bottom: var(--r-4);
  }
  .windex__nav {
    margin-top: var(--r-7);
    padding-top: var(--r-5);
    border-top: 1px solid var(--c-rule);
    font-family: var(--f-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-wide);
  }
</style>
