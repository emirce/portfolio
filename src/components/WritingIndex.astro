---
import { getWritingDate, getWritingEntries } from "../sanity/writing";
import PostRow from "./PostRow.astro";

const posts = await getWritingEntries();
---

<div class="wrap pt-8">
  <header class="mb-10">
    <h1 class="text-2xl font-semibold tracking-tight">Writing</h1>
    <p class="mt-2 text-muted">
      {posts.length > 0
        ? "Short notes on software, tooling, and whatever sticks at the desk."
        : "Nothing here yet."}
    </p>
  </header>

  {posts.length > 0 && (
    <ul class="grid gap-3">
      {posts.map((p) => (
        <PostRow key={p._id} title={p.title} date={getWritingDate(p)} slug={p.slug} />
      ))}
    </ul>
  )}
</div>
