---
interface Props {
  label: string;
  id?: string;
  number?: string;
}

const { label, id } = Astro.props;
---

<header
  class="mb-r-6 inline-flex items-baseline font-mono text-eyebrow font-semibold tracking-eyebrow text-ink uppercase"
  id={id}
>
  <span class="text-ink">{label}</span>
</header>
