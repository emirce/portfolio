---
interface Props {
  number: string;
  label: string;
  id?: string;
}

const { number, label, id } = Astro.props;
---

<header class="sechead" id={id}>
  <span class="sechead__pilcrow" aria-hidden="true">§</span>
  <span class="sechead__number">{number}</span>
  <span class="sechead__dash" aria-hidden="true">——</span>
  <span class="sechead__label">{label}</span>
</header>

<style>
.sechead {
  display: inline-flex;
  align-items: baseline;
  gap: 0.6ch;
  font-family: var(--f-mono);
  font-size: var(--t-eyebrow);
  font-weight: 600;
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
  color: var(--c-ink);
  margin-bottom: var(--r-6);
}
.sechead__pilcrow {
  color: var(--c-accent);
  font-weight: 600;
}
.sechead__number {
  color: var(--c-mute);
}
.sechead__dash {
  color: var(--c-faint);
  letter-spacing: 0;
}
.sechead__label {
  color: var(--c-ink);
}
</style>
