---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: Date;
  summary: string;
}

const { title, date, summary } = Astro.props;

const dateLong = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<BaseLayout title={`${title} — Emir Celovic`} description={summary}>
  <article class="wrap pt-8">
    <header class="mb-10">
      <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-2 text-muted">{summary}</p>
      <p class="mt-4 text-sm text-muted">
        <time datetime={date.toISOString()}>{dateLong}</time>
        · Written entirely by a human.
      </p>
    </header>

    <div class="prose"><slot /></div>

    <p class="mt-16 text-sm text-muted">
      <a class="link" href="/writing/">← All notes</a>
    </p>
  </article>
</BaseLayout>
